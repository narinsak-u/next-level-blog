# giscus requirements
NEXT_PUBLIC_GITHUB_NAME=
NEXT_PUBLIC_REPO=
NEXT_PUBLIC_REPO_ID=
NEXT_PUBLIC_CATEGORY_ID=

# notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
# Published workspace domain used by notion-client for page content.
NOTION_PUBLIC_SITE_URL=https://future-shawl-a38.notion.site

# pages (optional)
NOTION_NOTE_PAGE_ID=
NOTION_ABOUT_PAGE_ID=
NOTION_PROJECT_PAGE_ID=

# AI Summary (LLM Provider)
# Default: "openrouter". Set to "opencode" to use the Opencode provider.
PROVIDER_NAME=openrouter
# Required for OpenRouter (default provider)
OPENROUTER_API_KEY=
# Optional: model override (default: "google/gemma-3-27b-it:free")
OPENROUTER_LLM_MODEL=google/gemma-3-27b-it:free
# Required if PROVIDER_NAME=opencode
OPENCODE_API_KEY=
# Optional: model override (default: "deepseek-v4-flash")
OPENCODE_LLM_MODEL=deepseek-v4-flash

# On-demand revalidation (webhook secret)
REVALIDATION_SECRET=